{
  "name": "studyflow",
  "version": "1.0.0",
  "private": true,
  "description": "StudyFlow Student Productivity Platform",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
